{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Voodoobrew101/Loot-Liquidator/blob/research/processing-confidence/research/proposed/itemdb.schema.json",
  "title": "Loot Liquidator itemdb research evidence and isolated working estimates v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactStatus",
    "sourceManifest",
    "processing"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.2.0"
    },
    "artifactStatus": {
      "const": "RESEARCH_ONLY_NOT_SHIPPED"
    },
    "sourceManifest": {
      "type": "object",
      "required": [
        "gameDataSha",
        "statYieldProfilesSha",
        "reviewDate"
      ],
      "properties": {
        "gameDataSha": {
          "type": "string"
        },
        "statYieldProfilesSha": {
          "type": "string"
        },
        "reviewDate": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mechanicsRegistrySha": {
          "type": "string",
          "description": "SHA of reviewed ProfessionMechanicsRegistry at generation time"
        }
      },
      "additionalProperties": true
    },
    "processing": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/processingRecord"
      }
    },
    "unmigratedLegacy": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mechanicRules": {
      "type": "array",
      "default": [],
      "description": "Only independently reviewed and numerically verified rules approved for future itemdb.lua generation; empty until the compile gate is met.",
      "items": {
        "$ref": "#/$defs/compiledMechanicRule"
      }
    }
  },
  "$defs": {
    "sourceSelection": {
      "type": "object", "additionalProperties": false,
      "required": ["policyVersion", "sourceProfileKey", "selectedRecordID", "selectionReason", "targetContextSupplied", "normalizedVerified", "conflictFlags", "alternateProfiles"],
      "properties": {
        "policyVersion": {"const": "context-evidence-first-v1"},
        "sourceProfileKey": {"type": "string", "minLength": 1},
        "selectedRecordID": {"type": "string", "minLength": 1},
        "selectionReason": {"const": "APPLICABLE_CONTEXT_THEN_EVIDENCE_STRENGTH_THEN_COMPLETENESS"},
        "targetContextSupplied": {"type": "boolean"},
        "normalizedVerified": {"const": false},
        "conflictFlags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "alternateProfiles": {"type": "array", "items": {
          "type": "object", "additionalProperties": false,
          "required": ["recordID", "sourceProfileKey", "selectionReason"],
          "properties": {
            "recordID": {"type": "string", "minLength": 1},
            "sourceProfileKey": {"type": "string", "minLength": 1},
            "selectionReason": {"enum": ["LOWER_CONTEXT_EVIDENCE_PRIORITY", "KNOWN_CONTEXT_MISMATCH"]}
          }
        }}
      }
    },
    "workingEstimate": {
      "type": "object", "additionalProperties": false,
      "description": "Complete numerical preview only. Policy assumptions never replace evidence, establish baseline normalization, or authorize economic use.",
      "required": ["dropChance", "yieldMin", "yieldMax", "expectedQuantity", "policyVersion", "status", "economicUse", "modelID", "normalizedVerified", "evidenceFieldsPreserved", "fieldConfidence", "fieldStatus", "assumptions", "sourceRecordIDs", "conditionalYieldApplicable", "zeroSemantics", "uncertainty", "targetContext", "confidence"],
      "properties": {
        "dropChance": {"type": "number", "minimum": 0, "maximum": 1},
        "yieldMin": {"type": "integer", "minimum": 0},
        "yieldMax": {"type": "integer", "minimum": 0},
        "expectedQuantity": {"type": "number", "minimum": 0},
        "policyVersion": {"const": "working-estimate-policy-v1"},
        "status": {"enum": ["COPIED_EVIDENCE_PREVIEW", "PROVISIONAL_WORKING_ESTIMATE"]},
        "economicUse": {"const": "PREVIEW_ONLY"},
        "modelID": {"type": "string", "minLength": 1},
        "normalizedVerified": {"const": false},
        "evidenceFieldsPreserved": {"const": true},
        "confidence": {"type": "integer", "minimum": 0, "maximum": 100},
        "fieldConfidence": {
          "type": "object", "additionalProperties": false,
          "required": ["dropChance", "yieldMin", "yieldMax", "expectedQuantity"],
          "properties": {
            "dropChance": {"type": "integer", "minimum": 0, "maximum": 100},
            "yieldMin": {"type": "integer", "minimum": 0, "maximum": 100},
            "yieldMax": {"type": "integer", "minimum": 0, "maximum": 100},
            "expectedQuantity": {"type": "integer", "minimum": 0, "maximum": 100}
          }
        },
        "fieldStatus": {
          "type": "object", "additionalProperties": false,
          "required": ["dropChance", "yieldMin", "yieldMax", "expectedQuantity"],
          "properties": {
            "dropChance": {"enum": ["COPIED_EVIDENCE", "POLICY_PRIOR", "WORKING_CONSISTENCY_ADJUSTMENT"]},
            "yieldMin": {"enum": ["COPIED_EVIDENCE", "POLICY_PRIOR", "WORKING_CONSISTENCY_ADJUSTMENT"]},
            "yieldMax": {"enum": ["COPIED_EVIDENCE", "POLICY_PRIOR", "WORKING_CONSISTENCY_ADJUSTMENT"]},
            "expectedQuantity": {"enum": ["COPIED_EVIDENCE", "POLICY_PRIOR", "WORKING_CONSISTENCY_ADJUSTMENT"]}
          }
        },
        "assumptions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "sourceRecordIDs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "conditionalYieldApplicable": {"type": "boolean"},
        "zeroSemantics": {"enum": ["NO_ZERO_ASSERTION", "WORKING_ZERO_EXPECTATION_NOT_PROVEN_IMPOSSIBLE"]},
        "uncertainty": {"type": "string", "minLength": 1},
        "targetContext": {
          "type": "object", "additionalProperties": true,
          "required": ["contextID", "operationBasis", "skillAndStats", "eligibilityAssumedSatisfiedForPreview"],
          "properties": {
            "contextID": {"const": "HYPOTHETICAL_PREVIEW_NOT_VERIFIED_BASELINE"},
            "operationBasis": {"const": "ONE_COMPLETED_OPERATION"},
            "skillAndStats": {"const": "UNRESOLVED_NO_INVERSION_APPLIED"},
            "eligibilityAssumedSatisfiedForPreview": {"const": true}
          }
        },
        "allocation": {
          "type": "object", "additionalProperties": false,
          "required": ["poolID", "canonicalFamilyID", "status", "poolExpectedQuantity", "allocationShare", "memberRecordIDs", "physicalUpperBound"],
          "properties": {
            "poolID": {"type": "string", "minLength": 1},
            "canonicalFamilyID": {"type": ["string", "integer", "null"]},
            "status": {"const": "UNRESOLVED_RANK_ALLOCATION_POLICY_PRIOR"},
            "poolExpectedQuantity": {"type": "number", "exclusiveMinimum": 0},
            "allocationShare": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
            "memberRecordIDs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
            "physicalUpperBound": {"const": false}
          }
        }
      },
      "allOf": [
        {"if": {"properties": {"conditionalYieldApplicable": {"const": true}}}, "then": {"properties": {"yieldMin": {"minimum": 1}, "yieldMax": {"minimum": 1}, "dropChance": {"exclusiveMinimum": 0}, "expectedQuantity": {"exclusiveMinimum": 0}}}},
        {"if": {"properties": {"conditionalYieldApplicable": {"const": false}}}, "then": {"properties": {"yieldMin": {"const": 0}, "yieldMax": {"const": 0}, "dropChance": {"const": 0}, "expectedQuantity": {"const": 0}, "zeroSemantics": {"const": "WORKING_ZERO_EXPECTATION_NOT_PROVEN_IMPOSSIBLE"}}}},
        {"if": {"properties": {"assumptions": {"minItems": 1}}}, "then": {"properties": {"confidence": {"const": 0}}}}
      ]
    },
    "confidence": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 100
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "status",
        "confidence",
        "sourceClaimIDs",
        "blockers"
      ],
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "status": {
          "enum": [
            "official",
            "measured",
            "community-reported",
            "modeled",
            "proxy",
            "unknown",
            "contradictory"
          ]
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "sourceClaimIDs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sampleOperations": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "uncertainty": {
          "type": [
            "string",
            "null"
          ],
          "description": "Field-specific rounding or sampling uncertainty without inventing a confidence interval."
        }
      }
    },
    "processingRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recordID",
        "workingEstimate",
        "sourceSelection",
        "method",
        "expansionID",
        "inputItemID",
        "outputItemID",
        "recipeSpellID",
        "inputCountPerOperation",
        "inputQualityRank",
        "outputQualityRank",
        "conditions",
        "dropChance",
        "yieldMin",
        "yieldMax",
        "expectedQuantity",
        "mappingConfidence",
        "conditionsConfidence",
        "recordConfidence",
        "sources",
        "verifiedDate",
        "status"
      ],
      "properties": {
        "workingEstimate": {"$ref": "#/$defs/workingEstimate"},
        "sourceSelection": {"$ref": "#/$defs/sourceSelection"},
        "recordID": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "enum": [
            "Mill",
            "Prospect",
            "Disenchant",
            "Smelt",
            "Refine",
            "Recycle",
            "Exchange",
            "Other"
          ]
        },
        "expansionID": {
          "type": "integer",
          "minimum": 0
        },
        "inputItemID": {
          "type": "integer",
          "minimum": 1
        },
        "outputItemID": {
          "type": "integer",
          "minimum": 1
        },
        "recipeSpellID": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "inputCountPerOperation": {
          "type": "integer",
          "minimum": 1
        },
        "inputQualityRank": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "outputQualityRank": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "conditions": {
          "type": "object",
          "properties": {
            "gameMode": {
              "type": "string"
            },
            "patchWindow": {
              "type": [
                "string",
                "null"
              ]
            },
            "characterContext": {
              "enum": [
                "REAL",
                "SIMULATED",
                "CACHED_ALT",
                "REFERENCE_UNKNOWN"
              ]
            },
            "skillLineID": {
              "type": [
                "integer",
                "null"
              ]
            },
            "effectiveSkill": {
              "type": [
                "number",
                "null"
              ]
            },
            "specialization": {
              "type": [
                "object",
                "null"
              ]
            },
            "operationStats": {
              "type": [
                "object",
                "null"
              ]
            }
          },
          "additionalProperties": true
        },
        "dropChance": {
          "$ref": "#/$defs/probabilityField"
        },
        "yieldMin": {
          "$ref": "#/$defs/integerYieldField"
        },
        "yieldMax": {
          "$ref": "#/$defs/integerYieldField"
        },
        "expectedQuantity": {
          "$ref": "#/$defs/nonnegativeExpectationField"
        },
        "mappingConfidence": {
          "$ref": "#/$defs/confidence"
        },
        "conditionsConfidence": {
          "$ref": "#/$defs/confidence"
        },
        "recordConfidence": {
          "$ref": "#/$defs/confidence"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "verifiedDate": {
          "type": "string"
        },
        "status": {
          "const": "PROVISIONAL_CANDIDATE"
        },
        "reagents": {
          "type": "array",
          "minItems": 1,
          "description": "Exact direct reagent vector. inputItemID/inputCountPerOperation are a lookup anchor, not full Smelt cost.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "itemID",
              "quantity"
            ],
            "properties": {
              "itemID": {
                "type": "integer",
                "minimum": 1
              },
              "quantity": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "tooltipOnly": {
          "$ref": "#/$defs/tooltipOnly",
          "description": "Optional source-anchored display-only fallback; never used for gold, P/E, skill or economic confidence."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "method": {
                "const": "Smelt"
              }
            },
            "required": [
              "method"
            ]
          },
          "then": {
            "required": [
              "reagents"
            ]
          }
        }
      ]
    },
    "probabilityField": {
      "allOf": [
        {
          "$ref": "#/$defs/field"
        },
        {
          "properties": {
            "value": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      ]
    },
    "integerYieldField": {
      "allOf": [
        {
          "$ref": "#/$defs/field"
        },
        {
          "properties": {
            "value": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            }
          }
        }
      ]
    },
    "nonnegativeExpectationField": {
      "allOf": [
        {
          "$ref": "#/$defs/field"
        },
        {
          "properties": {
            "value": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            }
          }
        }
      ]
    },
    "compiledMechanicRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ruleID",
        "profession",
        "expansionID",
        "method",
        "effectTarget",
        "formulaID",
        "parameters",
        "parameterUnits",
        "scope",
        "referenceContext",
        "targetContext",
        "requiredLiveContext",
        "sources",
        "independentReview",
        "confidence0to100",
        "evidenceStatus",
        "applyPolicy",
        "numericTransformValidated"
      ],
      "properties": {
        "ruleID": {
          "type": "string",
          "minLength": 1
        },
        "profession": {
          "type": "string",
          "minLength": 1
        },
        "expansionID": {
          "type": "integer",
          "minimum": 0,
          "maximum": 11
        },
        "method": {
          "enum": [
            "Prospect",
            "Mill",
            "Disenchant",
            "Smelt",
            "Crush",
            "Shatter",
            "Recycle",
            "Other"
          ]
        },
        "effectTarget": {
          "enum": [
            "OUTPUT_OCCURRENCE",
            "OUTPUT_UNCONDITIONAL_EXPECTATION",
            "OUTPUT_QUALITY",
            "OUTPUT_ELIGIBILITY",
            "EXPECTED_INPUT_CONSUMPTION",
            "OPERATION_DURATION"
          ]
        },
        "formulaID": {
          "enum": [
            "RATIO_ADJUSTMENT",
            "ADDITIVE_EXPECTATION",
            "RATIO_ADJUSTMENT_OCCURRENCE",
            "QUALITY_TRANSITION_MATRIX",
            "EXPECTED_INPUT_SAVINGS",
            "VERIFIED_ELIGIBILITY",
            "DURATION_ADJUSTMENT"
          ]
        },
        "parameters": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "array",
                  "minItems": 2,
                  "items": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              }
            ]
          },
          "description": "Reviewed scalar formula parameters or, for QUALITY_TRANSITION_MATRIX only, rows of conditional output quality probabilities; validator checks all rows sum to 1."
        },
        "parameterUnits": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "scope": {
          "type": "object",
          "required": [
            "gameMode",
            "recipeSpellIDs",
            "inputItemIDs",
            "outputItemIDs",
            "nominalInputCount",
            "patchStartBuild",
            "patchEndBuild"
          ],
          "properties": {
            "gameMode": {
              "const": "RETAIL"
            },
            "recipeSpellIDs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            "inputItemIDs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            "outputItemIDs": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            "nominalInputCount": {
              "type": "integer",
              "minimum": 1
            },
            "inputQualityRanks": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            "outputQualityRanks": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            "patchStartBuild": {
              "type": "string",
              "minLength": 1
            },
            "patchEndBuild": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "referenceContext": {
          "type": "object",
          "minProperties": 1
        },
        "targetContext": {
          "type": "object",
          "minProperties": 1
        },
        "requiredLiveContext": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sources": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "claimID",
              "url",
              "evidenceKind"
            ],
            "properties": {
              "claimID": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "minLength": 1
              },
              "evidenceKind": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        },
        "independentReview": {
          "type": "object",
          "required": [
            "reviewer",
            "reviewedAt",
            "passedTestIDs"
          ],
          "properties": {
            "reviewer": {
              "type": "string",
              "minLength": 1
            },
            "reviewedAt": {
              "type": "string",
              "minLength": 1
            },
            "passedTestIDs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": true
        },
        "confidence0to100": {
          "type": "integer",
          "minimum": 90,
          "maximum": 100
        },
        "evidenceStatus": {
          "const": "VERIFIED_NUMERIC"
        },
        "applyPolicy": {
          "const": "VERIFIED_FOR_COMPILE"
        },
        "numericTransformValidated": {
          "const": true
        },
        "blockers": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "tooltipOnly": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dropChance",
        "yieldMin",
        "yieldMax",
        "confidence",
        "source",
        "status",
        "uncertainty",
        "economicUse",
        "displayOnly",
        "profileIsMeasured",
        "denominatorVerifiedCompletedCasts"
      ],
      "properties": {
        "dropChance": {
          "type": "null",
          "description": "No P(>=1) can be compiled from crowdsourced event counts without verified zero-inclusive completed casts."
        },
        "yieldMin": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "yieldMax": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "source": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "url",
            "sourceType",
            "extractedOn",
            "profileLabel",
            "sourceObservedMax",
            "rawEventRatio",
            "rawCount",
            "rawOutOf",
            "denominatorUnit",
            "claimID",
            "positiveYieldUnit"
          ],
          "properties": {
            "url": {
              "type": "string"
            },
            "sourceType": {
              "type": "string"
            },
            "extractedOn": {
              "type": "string"
            },
            "profileLabel": {
              "type": "string"
            },
            "sourceObservedMax": {
              "type": "integer",
              "minimum": 1
            },
            "rawEventRatio": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Crowdsourced event ratio, explicitly NOT P per completed operation"
            },
            "rawCount": {
              "type": "integer",
              "minimum": 1
            },
            "rawOutOf": {
              "type": "integer",
              "minimum": 1
            },
            "denominatorUnit": {
              "type": "string"
            },
            "claimID": {
              "type": "string"
            },
            "positiveYieldUnit": {
              "type": "string"
            }
          }
        },
        "status": {
          "const": "PROVISIONAL_TOOLTIP_ONLY_NOT_ECONOMIC"
        },
        "uncertainty": {
          "type": "string"
        },
        "economicUse": {
          "const": "PROHIBITED"
        },
        "displayOnly": {
          "const": true
        },
        "profileIsMeasured": {
          "const": false
        },
        "denominatorVerifiedCompletedCasts": {
          "const": false
        }
      }
    }
  }
}

