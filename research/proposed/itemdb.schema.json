{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Voodoobrew101/Loot-Liquidator/blob/research/processing-confidence/research/proposed/itemdb.schema.json",
  "title": "Loot Liquidator future itemdb.lua source-record research schema v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactStatus",
    "sourceManifest",
    "processing"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1.0"
    },
    "artifactStatus": {
      "const": "RESEARCH_ONLY_NOT_SHIPPED"
    },
    "sourceManifest": {
      "type": "object",
      "required": [
        "gameDataSha",
        "statYieldProfilesSha",
        "reviewDate"
      ],
      "properties": {
        "gameDataSha": {
          "type": "string"
        },
        "statYieldProfilesSha": {
          "type": "string"
        },
        "reviewDate": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mechanicsRegistrySha": {
          "type": "string",
          "description": "SHA of reviewed ProfessionMechanicsRegistry at generation time"
        }
      },
      "additionalProperties": true
    },
    "processing": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/processingRecord"
      }
    },
    "unmigratedLegacy": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mechanicRules": {
      "type": "array",
      "default": [],
      "description": "Only independently reviewed and numerically verified rules approved for future itemdb.lua generation; empty until the compile gate is met.",
      "items": {
        "$ref": "#/$defs/compiledMechanicRule"
      }
    }
  },
  "$defs": {
    "confidence": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 100
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "status",
        "confidence",
        "sourceClaimIDs",
        "blockers"
      ],
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "status": {
          "enum": [
            "official",
            "measured",
            "community-reported",
            "modeled",
            "proxy",
            "unknown",
            "contradictory"
          ]
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "sourceClaimIDs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sampleOperations": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "processingRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recordID",
        "method",
        "expansionID",
        "inputItemID",
        "outputItemID",
        "recipeSpellID",
        "inputCountPerOperation",
        "inputQualityRank",
        "outputQualityRank",
        "conditions",
        "dropChance",
        "yieldMin",
        "yieldMax",
        "expectedQuantity",
        "mappingConfidence",
        "conditionsConfidence",
        "recordConfidence",
        "sources",
        "verifiedDate",
        "status"
      ],
      "properties": {
        "recordID": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "enum": [
            "Mill",
            "Prospect",
            "Disenchant",
            "Smelt",
            "Recycle",
            "Exchange",
            "Other"
          ]
        },
        "expansionID": {
          "type": "integer",
          "minimum": 0
        },
        "inputItemID": {
          "type": "integer",
          "minimum": 1
        },
        "outputItemID": {
          "type": "integer",
          "minimum": 1
        },
        "recipeSpellID": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "inputCountPerOperation": {
          "type": "integer",
          "minimum": 1
        },
        "inputQualityRank": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "outputQualityRank": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "conditions": {
          "type": "object",
          "properties": {
            "gameMode": {
              "type": "string"
            },
            "patchWindow": {
              "type": [
                "string",
                "null"
              ]
            },
            "characterContext": {
              "enum": [
                "REAL",
                "SIMULATED",
                "CACHED_ALT",
                "REFERENCE_UNKNOWN"
              ]
            },
            "skillLineID": {
              "type": [
                "integer",
                "null"
              ]
            },
            "effectiveSkill": {
              "type": [
                "number",
                "null"
              ]
            },
            "specialization": {
              "type": [
                "object",
                "null"
              ]
            },
            "operationStats": {
              "type": [
                "object",
                "null"
              ]
            }
          },
          "additionalProperties": true
        },
        "dropChance": {
          "$ref": "#/$defs/probabilityField"
        },
        "yieldMin": {
          "$ref": "#/$defs/integerYieldField"
        },
        "yieldMax": {
          "$ref": "#/$defs/integerYieldField"
        },
        "expectedQuantity": {
          "$ref": "#/$defs/nonnegativeExpectationField"
        },
        "mappingConfidence": {
          "$ref": "#/$defs/confidence"
        },
        "conditionsConfidence": {
          "$ref": "#/$defs/confidence"
        },
        "recordConfidence": {
          "$ref": "#/$defs/confidence"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "verifiedDate": {
          "type": "string"
        },
        "status": {
          "const": "PROVISIONAL_CANDIDATE"
        }
      }
    },
    "probabilityField": {
      "allOf": [
        {
          "$ref": "#/$defs/field"
        },
        {
          "properties": {
            "value": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      ]
    },
    "integerYieldField": {
      "allOf": [
        {
          "$ref": "#/$defs/field"
        },
        {
          "properties": {
            "value": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            }
          }
        }
      ]
    },
    "nonnegativeExpectationField": {
      "allOf": [
        {
          "$ref": "#/$defs/field"
        },
        {
          "properties": {
            "value": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            }
          }
        }
      ]
    },
    "compiledMechanicRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ruleID",
        "profession",
        "expansionID",
        "method",
        "effectTarget",
        "formulaID",
        "parameters",
        "parameterUnits",
        "scope",
        "referenceContext",
        "targetContext",
        "requiredLiveContext",
        "sources",
        "independentReview",
        "confidence0to100",
        "evidenceStatus",
        "applyPolicy",
        "numericTransformValidated"
      ],
      "properties": {
        "ruleID": {
          "type": "string",
          "minLength": 1
        },
        "profession": {
          "type": "string",
          "minLength": 1
        },
        "expansionID": {
          "type": "integer",
          "minimum": 0,
          "maximum": 11
        },
        "method": {
          "enum": [
            "Prospect",
            "Mill",
            "Disenchant",
            "Smelt",
            "Crush",
            "Shatter",
            "Recycle",
            "Other"
          ]
        },
        "effectTarget": {
          "enum": [
            "OUTPUT_OCCURRENCE",
            "OUTPUT_UNCONDITIONAL_EXPECTATION",
            "OUTPUT_QUALITY",
            "OUTPUT_ELIGIBILITY",
            "EXPECTED_INPUT_CONSUMPTION",
            "OPERATION_DURATION"
          ]
        },
        "formulaID": {
          "enum": [
            "RATIO_ADJUSTMENT",
            "ADDITIVE_EXPECTATION",
            "RATIO_ADJUSTMENT_OCCURRENCE",
            "QUALITY_TRANSITION_MATRIX",
            "EXPECTED_INPUT_SAVINGS",
            "VERIFIED_ELIGIBILITY",
            "DURATION_ADJUSTMENT"
          ]
        },
        "parameters": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "number"
          }
        },
        "parameterUnits": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "scope": {
          "type": "object",
          "required": [
            "gameMode",
            "recipeSpellIDs",
            "inputItemIDs",
            "outputItemIDs",
            "nominalInputCount",
            "patchStartBuild",
            "patchEndBuild"
          ],
          "properties": {
            "gameMode": {
              "const": "RETAIL"
            },
            "recipeSpellIDs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            "inputItemIDs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            "outputItemIDs": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            "nominalInputCount": {
              "type": "integer",
              "minimum": 1
            },
            "inputQualityRanks": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            "outputQualityRanks": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            "patchStartBuild": {
              "type": "string",
              "minLength": 1
            },
            "patchEndBuild": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "referenceContext": {
          "type": "object",
          "minProperties": 1
        },
        "targetContext": {
          "type": "object",
          "minProperties": 1
        },
        "requiredLiveContext": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sources": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "claimID",
              "url",
              "evidenceKind"
            ],
            "properties": {
              "claimID": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "minLength": 1
              },
              "evidenceKind": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        },
        "independentReview": {
          "type": "object",
          "required": [
            "reviewer",
            "reviewedAt",
            "passedTestIDs"
          ],
          "properties": {
            "reviewer": {
              "type": "string",
              "minLength": 1
            },
            "reviewedAt": {
              "type": "string",
              "minLength": 1
            },
            "passedTestIDs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": true
        },
        "confidence0to100": {
          "type": "integer",
          "minimum": 90,
          "maximum": 100
        },
        "evidenceStatus": {
          "const": "VERIFIED_NUMERIC"
        },
        "applyPolicy": {
          "const": "VERIFIED_FOR_COMPILE"
        },
        "numericTransformValidated": {
          "const": true
        },
        "blockers": {
          "type": "array",
          "maxItems": 0
        }
      }
    }
  }
}
