#!/usr/bin/env python3
"""Small Lua 5.1 file/stdin runner, not a full native CLI replacement."""
import os
import sys

import lupa.lua51 as lua51


def main():
    script = sys.argv[1] if len(sys.argv) > 1 else "-"
    args = sys.argv[2:]
    if script.startswith("-") and script != "-":
        sys.stderr.write("lua5.1 shim: expected FILE or - (CLI options are unsupported)\n")
        return 1
    # Lua strings are bytes. Keep source, paths, arguments and binary chunk
    # contents out of Python's text decoder. loadfile(nil) reads C stdin and
    # preserves Lua's own file-loader behavior, including shebang handling.
    runtime = lua51.LuaRuntime(encoding=None, unpack_returned_tuples=True)
    argv = runtime.table()
    argv[0] = os.fsencode(script)
    argv[-1] = os.fsencode(sys.argv[0])
    arguments = [os.fsencode(arg) for arg in args]
    for index, arg in enumerate(arguments, 1):
        argv[index] = arg
    runtime.globals()[b"arg"] = argv
    run = runtime.eval(b"""function(path, ...)
        local chunk, err = loadfile(path)
        if not chunk then error(err, 0) end
        chunk(...)
    end""")
    try:
        run(None if script == "-" else os.fsencode(script), *arguments)
    except lua51.LuaError as error:
        sys.stderr.write("lua5.1: %s\n" % error)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
